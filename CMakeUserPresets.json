{
    "version": 6,
    "include": [
        "CMakePresets.json"
    ],
    "configurePresets": [
        {
            "name": "win-toolchain",
            "hidden": true,
            "environment": {
                "PROJECT_ROOT": "C:/projects/cpp",
                "PKG_ROOT": "$env{PROJECT_ROOT}/external/pkgs",
                "VCPKG_ROOT": "C:/tools/vcpkg",
                "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed"
            }
        },
        {
            "name": "win-paths",
            "hidden": true,
            "inherits": "win-toolchain",
            "cacheVariables": {
                "VCPKG_INSTALLED_DIR": "$env{VCPKG_INSTALLED_DIR}",
                "PKG_CONFIG_EXECUTABLE": "$env{VCPKG_INSTALLED_DIR}/x64-windows/tools/pkgconf/pkgconf.exe",
                "VCPKG_TARGET_TRIPLET": "x64-windows",
                "VCPKG_MANIFEST_MODE": "ON"
            },
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "toolset": {
                "value": "host=x64",
                "strategy": "external"
            }
        },
        {
            "name": "linux-paths",
            "hidden": true,
            "cacheVariables": {
                "VCPKG_INSTALLED_DIR": "$env{VCPKG_INSTALLED_DIR}",
                "VCPKG_TARGET_TRIPLET": "x64-linux",
                "VCPKG_MANIFEST_MODE": "ON"
            },
            "environment": {
                "PKG_ROOT": "/opt",
                "VCPKG_ROOT": "/opt/vcpkg",
                "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed"
            }
        },
        {
            "name": "win-dev-user",
            "displayName": "Developer Build (Windows, User)",
            "cacheVariables": {
                "ENABLE_SANITIZER_ADDRESS": "ON",
                "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-windows/debug",
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/kfcore/debug"
            },
            "environment": {
                "TURBOUTILS_ROOT": "$env{PKG_ROOT}/turboutils/debug",
                "TURBOPARSER_ROOT": "$env{PKG_ROOT}/turboparser/debug",
                "TURBONET_ROOT": "$env{PKG_ROOT}/turbonet/debug",
                "PATH": "${sourceDir}/build/Msvc/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-windows/debug/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-windows/bin${pathListSep}$env{TURBOUTILS_ROOT}/bin${pathListSep}$env{TURBOPARSER_ROOT}/bin${pathListSep}$env{TURBONET_ROOT}/bin${pathListSep}$penv{PATH}"
            },
            "inherits": [
                "base-win-dev-user",
                "win-paths"
            ]
        },
        {
            "name": "win-release-user",
            "displayName": "Release Build (Windows, User)",
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-windows",
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/kfcore/release"
            },
            "environment": {
                "TURBOUTILS_ROOT": "$env{PKG_ROOT}/turboutils/release",
                "TURBOPARSER_ROOT": "$env{PKG_ROOT}/turboparser/release",
                "TURBONET_ROOT": "$env{PKG_ROOT}/turbonet/release",
                "PATH": "${sourceDir}/build/Msvc-Release/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-windows/bin${pathListSep}$env{TURBOUTILS_ROOT}/bin${pathListSep}$env{TURBOPARSER_ROOT}/bin${pathListSep}$env{TURBONET_ROOT}/bin${pathListSep}$penv{PATH}"
            },
            "inherits": [
                "base-win-release-user",
                "win-paths"
            ]
        },
        {
            "name": "win-yolo-tracking-dev-user",
            "displayName": "YOLO Tracking Developer Build (Windows, User)",
            "inherits": "win-dev-user",
            "cacheVariables": {
                "KFCORE_BUILD_YOLO_TRACKING": "ON"
            }
        },
        {
            "name": "win-yolo-release-user",
            "displayName": "YOLO TensorRT Release Build (Windows, User)",
            "inherits": "win-release-user",
            "environment": {
                "TENSORRT_ROOT": "$penv{TENSORRT_ROOT}",
                "OPENCV_LITE_ROOT": "$env{PKG_ROOT}/opencv-lite",
                "PATH": "$env{TENSORRT_ROOT}/bin${pathListSep}$env{TENSORRT_ROOT}/lib${pathListSep}$env{OPENCV_LITE_ROOT}/bin${pathListSep}${sourceDir}/build/Msvc-Release/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-windows/bin${pathListSep}$env{TURBOUTILS_ROOT}/bin${pathListSep}$env{TURBOPARSER_ROOT}/bin${pathListSep}$env{TURBONET_ROOT}/bin${pathListSep}$penv{PATH}"
            },
            "cacheVariables": {
                "KFCORE_BUILD_YOLO_TRACKING": "ON",
                "KFCORE_BUILD_TENSORRT_YOLO": "ON",
                "KFCORE_BUILD_YOLO_OPENCV": "ON"
            }
        },
        {
            "name": "linux-dev-user",
            "displayName": "Developer Build (Linux, User)",
            "cacheVariables": {
                "ENABLE_SANITIZER_ADDRESS": "ON",
                "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-linux/debug",
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/kfcore/debug"
            },
            "environment": {
                "TURBOUTILS_ROOT": "$env{PKG_ROOT}/turboutils/debug",
                "TURBOPARSER_ROOT": "$env{PKG_ROOT}/turboparser/debug",
                "TURBONET_ROOT": "$env{PKG_ROOT}/turbonet/debug",
                "PATH": "${sourceDir}/build/linux-gcc-debug/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-linux/debug/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-linux/bin${pathListSep}$env{TURBOUTILS_ROOT}/bin${pathListSep}$env{TURBOPARSER_ROOT}/bin${pathListSep}$env{TURBONET_ROOT}/bin${pathListSep}$penv{PATH}",
                "LD_LIBRARY_PATH": "${sourceDir}/build/linux-gcc-debug/lib${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-linux/debug/lib${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-linux/lib${pathListSep}$env{TURBOUTILS_ROOT}/lib${pathListSep}$env{TURBOPARSER_ROOT}/lib${pathListSep}$env{TURBONET_ROOT}/lib${pathListSep}$penv{LD_LIBRARY_PATH}"
            },
            "inherits": [
                "base-linux-dev-user",
                "linux-paths"
            ]
        },
        {
            "name": "linux-release-user",
            "displayName": "Release Build (Linux, User)",
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-linux",
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/kfcore/release"
            },
            "environment": {
                "TURBOUTILS_ROOT": "$env{PKG_ROOT}/turboutils/release",
                "TURBOPARSER_ROOT": "$env{PKG_ROOT}/turboparser/release",
                "TURBONET_ROOT": "$env{PKG_ROOT}/turbonet/release",
                "PATH": "${sourceDir}/build/linux-gcc-release/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-linux/bin${pathListSep}$env{TURBOUTILS_ROOT}/bin${pathListSep}$env{TURBOPARSER_ROOT}/bin${pathListSep}$env{TURBONET_ROOT}/bin${pathListSep}$penv{PATH}",
                "LD_LIBRARY_PATH": "${sourceDir}/build/linux-gcc-release/lib${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-linux/lib${pathListSep}$env{TURBOUTILS_ROOT}/lib${pathListSep}$env{TURBOPARSER_ROOT}/lib${pathListSep}$env{TURBONET_ROOT}/lib${pathListSep}$penv{LD_LIBRARY_PATH}"
            },
            "inherits": [
                "release-linux-ninja",
                "linux-paths"
            ]
        }
    ],
    "buildPresets": [
        {
            "name": "win-dev-user",
            "configurePreset": "win-dev-user"
        },
        {
            "name": "win-release-user",
            "configurePreset": "win-release-user"
        },
        {
            "name": "win-yolo-tracking-dev-user",
            "inherits": "win-dev-user",
            "configurePreset": "win-yolo-tracking-dev-user"
        },
        {
            "name": "win-yolo-release-user",
            "inherits": "win-release-user",
            "configurePreset": "win-yolo-release-user"
        },
        {
            "name": "linux-dev-user",
            "configurePreset": "linux-dev-user"
        },
        {
            "name": "linux-release-user",
            "configurePreset": "linux-release-user"
        },
        {
            "name": "install-win-dev-user",
            "configurePreset": "win-dev-user",
            "targets": [
                "install"
            ]
        },
        {
            "name": "install-win-release-user",
            "configurePreset": "win-release-user",
            "targets": [
                "install"
            ]
        },
        {
            "name": "install-win-yolo-tracking-dev-user",
            "inherits": "install-win-dev-user",
            "configurePreset": "win-yolo-tracking-dev-user",
            "targets": [
                "install"
            ]
        },
        {
            "name": "install-win-yolo-release-user",
            "inherits": "install-win-release-user",
            "configurePreset": "win-yolo-release-user",
            "targets": [
                "install"
            ]
        },
        {
            "name": "install-linux-dev-user",
            "configurePreset": "linux-dev-user",
            "targets": [
                "install"
            ]
        },
        {
            "name": "install-linux-release-user",
            "configurePreset": "linux-release-user",
            "targets": [
                "install"
            ]
        }
    ],
    "testPresets": [
        {
            "name": "win-dev-user",
            "inherits": "base-test",
            "configurePreset": "win-dev-user"
        },
        {
            "name": "win-release-user",
            "inherits": "base-test",
            "configurePreset": "win-release-user"
        },
        {
            "name": "win-yolo-tracking-dev-user",
            "inherits": "win-dev-user",
            "configurePreset": "win-yolo-tracking-dev-user"
        },
        {
            "name": "win-yolo-release-user",
            "inherits": "win-release-user",
            "configurePreset": "win-yolo-release-user"
        },
        {
            "name": "linux-dev-user",
            "inherits": "base-test",
            "configurePreset": "linux-dev-user"
        },
        {
            "name": "linux-release-user",
            "inherits": "base-test",
            "configurePreset": "linux-release-user"
        }
    ]
}
