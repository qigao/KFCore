{
    "version": 6,
    "include": [
        "CMakePresets.json"
    ],
    "configurePresets": [
        {
            "name": "win-toolchain",
            "hidden": true,
            "environment": {
                "PROJECT_ROOT": "C:/projects/cpp",
                "PKG_ROOT": "$env{PROJECT_ROOT}/external/pkgs",
                "CUDA_TOOLKIT_ROOT": "$penv{CUDA_PATH_V12_8}",
                "TENSORRT_ROOT": "C:/projects/TensorRT-11.2.1.2",
                "ONNXRUNTIME_ROOT": "$env{PKG_ROOT}/onnxruntime",
                "OPENCV_LITE_ROOT": "$env{PKG_ROOT}/opencv-lite",
                "VCPKG_ROOT": "C:/tools/vcpkg",
                "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed"
            }
        },
        {
            "name": "win-paths",
            "hidden": true,
            "inherits": "win-toolchain",
            "cacheVariables": {
                "VCPKG_INSTALLED_DIR": "$env{VCPKG_INSTALLED_DIR}",
                "CMAKE_CUDA_COMPILER": "$env{CUDA_TOOLKIT_ROOT}/bin/nvcc.exe",
                "CUDAToolkit_ROOT": "$env{CUDA_TOOLKIT_ROOT}",
                "PKG_CONFIG_EXECUTABLE": "$env{VCPKG_INSTALLED_DIR}/x64-windows/tools/pkgconf/pkgconf.exe",
                "VCPKG_TARGET_TRIPLET": "x64-windows",
                "VCPKG_MANIFEST_MODE": "ON"
            },
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "toolset": {
                "value": "host=x64",
                "strategy": "external"
            }
        },
        {
            "name": "linux-paths",
            "hidden": true,
            "cacheVariables": {
                "VCPKG_INSTALLED_DIR": "$env{VCPKG_INSTALLED_DIR}",
                "VCPKG_TARGET_TRIPLET": "x64-linux",
                "VCPKG_MANIFEST_MODE": "ON"
            },
            "environment": {
                "PKG_ROOT": "/opt",
                "VCPKG_ROOT": "/opt/vcpkg",
                "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed"
            }
        },
        {
            "name": "win-dev-user",
            "displayName": "Developer Build (Windows, User)",
            "cacheVariables": {
                "BUILD_EXAMPLES": "ON",
                "BUILD_TESTS": "ON",
                "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-windows/debug",
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/kfcore/debug"
            },
            "environment": {
                "SALTS_ROOT": "$env{PKG_ROOT}/salts/debug",
                "SALTS_UTILS_ROOT": "$env{PKG_ROOT}/salts-utils/debug",
                "PATH": "$env{CUDA_TOOLKIT_ROOT}/bin${pathListSep}$env{TENSORRT_ROOT}/bin${pathListSep}$env{ONNXRUNTIME_ROOT}/lib${pathListSep}$env{OPENCV_LITE_ROOT}/bin${pathListSep}${sourceDir}/build/Msvc/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-windows/debug/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-windows/bin${pathListSep}$env{SALTS_ROOT}/bin${pathListSep}${pathListSep}$penv{PATH}"
            },
            "inherits": [
                "base-win-dev-user",
                "win-paths"
            ]
        },
        {
            "name": "win-release-user",
            "displayName": "Release Build (Windows, User)",
            "cacheVariables": {
                "BUILD_EXAMPLES": "ON",
                "BUILD_TESTS": "ON",
                "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-windows",
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/kfcore/release"
            },
            "environment": {
                "SALTS_ROOT": "$env{PKG_ROOT}/salts/release",
                "SALTS_UTILS_ROOT": "$env{PKG_ROOT}/salts-utils/release",
                "PATH": "$env{CUDA_TOOLKIT_ROOT}/bin${pathListSep}$env{TENSORRT_ROOT}/bin${pathListSep}$env{ONNXRUNTIME_ROOT}/lib${pathListSep}$env{OPENCV_LITE_ROOT}/bin${pathListSep}${sourceDir}/build/Msvc-Release/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-windows/bin${pathListSep}$env{SALTS_ROOT}/bin${pathListSep}${pathListSep}$penv{PATH}"
            },
            "inherits": [
                "base-win-release-user",
                "win-paths"
            ]
        },
        {
            "name": "linux-dev-user",
            "displayName": "Developer Build (Linux, User)",
            "cacheVariables": {
                "BUILD_TESTS": "ON",
                "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-linux/debug",
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/kfcore/debug"
            },
            "environment": {
                "SALTS_ROOT": "$env{PKG_ROOT}/salts/debug",
                "SALTS_UTILS_ROOT": "$env{PKG_ROOT}/salts-utils/debug",
                "PATH": "${sourceDir}/build/linux-gcc-debug/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-linux/debug/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-linux/bin${pathListSep}$env{SALTS_ROOT}/bin${pathListSep}${pathListSep}$penv{PATH}",
                "LD_LIBRARY_PATH": "${sourceDir}/build/linux-gcc-debug/lib${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-linux/debug/lib${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-linux/lib${pathListSep}$env{SALTS_ROOT}/lib${pathListSep}${pathListSep}$penv{LD_LIBRARY_PATH}"
            },
            "inherits": [
                "base-linux-dev-user",
                "linux-paths"
            ]
        },
        {
            "name": "linux-release-user",
            "displayName": "Release Build (Linux, User)",
            "cacheVariables": {
                "BUILD_TESTS": "ON",
                "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-linux",
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/kfcore/release"
            },
            "environment": {
                "SALTS_ROOT": "$env{PKG_ROOT}/salts/release",
                "SALTS_UTILS_ROOT": "$env{PKG_ROOT}/salts-utils/release",
                "PATH": "${sourceDir}/build/linux-gcc-release/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-linux/bin${pathListSep}$env{SALTS_ROOT}/bin${pathListSep}${pathListSep}$penv{PATH}",
                "LD_LIBRARY_PATH": "${sourceDir}/build/linux-gcc-release/lib${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-linux/lib${pathListSep}$env{SALTS_ROOT}/lib${pathListSep}${pathListSep}$penv{LD_LIBRARY_PATH}"
            },
            "inherits": [
                "release-linux-ninja",
                "linux-paths"
            ]
        }
    ],
    "buildPresets": [
        {
            "name": "win-dev-user",
            "configurePreset": "win-dev-user"
        },
        {
            "name": "win-release-user",
            "configurePreset": "win-release-user"
        },
        {
            "name": "linux-dev-user",
            "configurePreset": "linux-dev-user"
        },
        {
            "name": "linux-release-user",
            "configurePreset": "linux-release-user"
        }
    ],
    "testPresets": [
        {
            "name": "win-dev-user",
            "inherits": "base-test",
            "configurePreset": "win-dev-user"
        },
        {
            "name": "win-release-user",
            "inherits": "base-test",
            "configurePreset": "win-release-user"
        },
        {
            "name": "linux-dev-user",
            "inherits": "base-test",
            "configurePreset": "linux-dev-user"
        },
        {
            "name": "linux-release-user",
            "inherits": "base-test",
            "configurePreset": "linux-release-user"
        }
    ]
}
