@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(KFCore_HAS_IMAGE_CORE "@KFCORE_IMAGE_CORE_ENABLED@")
set(KFCore_HAS_IMAGE_PROCESSOR "@KFCORE_IMAGE_PROCESSOR_CUDA_ENABLED@")
set(KFCore_HAS_SIFT "@KFCORE_BUILD_SIFT@")
set(KFCore_HAS_SIFT_POPSIFT "@KFCORE_BUILD_SIFT_POPSIFT@")
set(KFCore_HAS_YOLO_TRACKING "@KFCORE_BUILD_YOLO_TRACKING@")
set(KFCore_HAS_TENSORRT_YOLO "@KFCORE_BUILD_TENSORRT_YOLO@")
set(KFCore_HAS_YOLO_OPENCV "@KFCORE_BUILD_YOLO_OPENCV@")
set(KFCore_HAS_TENSORRT_RUNTIME "@KFCORE_BUILD_TENSORRT_RUNTIME@")
set(KFCore_HAS_FACE_MODELS "@KFCORE_BUILD_FACE_MODELS@")
set(KFCore_HAS_FACE_APPLICATIONS "@KFCORE_BUILD_FACE_APPLICATIONS@")
set(KFCore_HAS_FACE_APPLICATIONS_CPU "@KFCORE_BUILD_FACE_APPLICATIONS_CPU@")
set(KFCore_HAS_VISION_MODELS "@KFCORE_BUILD_VISION_MODELS@")
set(KFCore_HAS_VISION_MODELS_CPU "@KFCORE_BUILD_VISION_MODELS_CPU@")
set(KFCore_HAS_VISION_MODELS_TENSORRT "@KFCORE_BUILD_VISION_MODELS_TENSORRT@")
set(KFCore_HAS_THIG "@KFCORE_BUILD_THIG@")
set(KFCore_HAS_HAND_INTERACTION "@KFCORE_BUILD_HAND_INTERACTION@")

if(KFCore_HAS_IMAGE_PROCESSOR OR KFCore_HAS_TENSORRT_RUNTIME)
  find_dependency(CUDAToolkit)
endif()

if(KFCore_HAS_TENSORRT_RUNTIME OR KFCore_HAS_TENSORRT_YOLO)
  list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
  find_package(TensorRT REQUIRED MODULE)
endif()

if(KFCore_HAS_YOLO_OPENCV)
  list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
  find_package(OpenCVLite REQUIRED MODULE COMPONENTS core imgproc)
endif()

if(KFCore_HAS_FACE_MODELS OR KFCore_HAS_FACE_APPLICATIONS_CPU)
  file(TO_CMAKE_PATH "$ENV{TURBOUTILS_ROOT}" _kfcore_turboutils_root)
  find_dependency(TurboUtils CONFIG REQUIRED
    PATHS "${_kfcore_turboutils_root}"
    NO_DEFAULT_PATH)
endif()

if(KFCore_HAS_FACE_APPLICATIONS_CPU OR KFCore_HAS_VISION_MODELS_CPU)
  list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
  find_dependency(ONNXRuntime REQUIRED MODULE)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/KFCoreTargets.cmake")

if(KFCore_HAS_YOLO_TRACKING)
  find_dependency(trackers CONFIG
    PATHS "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/cmake/trackers"
    NO_DEFAULT_PATH)
endif()

check_required_components(KFCore)
