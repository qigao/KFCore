@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
find_dependency(CUDAToolkit)
find_package(TensorRT REQUIRED MODULE)
file(TO_CMAKE_PATH "$ENV{TURBOUTILS_ROOT}" _kfcore_turboutils_root)
find_dependency(TurboUtils CONFIG REQUIRED
  PATHS "${_kfcore_turboutils_root}"
  NO_DEFAULT_PATH)
find_dependency(ONNXRuntime REQUIRED MODULE)

include("${CMAKE_CURRENT_LIST_DIR}/KFCoreTargets.cmake")

find_dependency(trackers CONFIG
  PATHS "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/cmake/trackers"
  NO_DEFAULT_PATH)

check_required_components(KFCore)
