@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(KFCore_CUDA_ENABLED @KFCORE_ENABLE_CUDA@)
set(KFCore_TENSORRT_ENABLED @KFCORE_ENABLE_TENSORRT@)
set(KFCore_ONNXRUNTIME_ENABLED @KFCORE_ENABLE_ONNXRUNTIME@)
set(KFCore_ONNXRUNTIME_CUDA_ENABLED @KFCORE_ONNXRUNTIME_ENABLE_CUDA@)
set(KFCore_ONNXRUNTIME_CPU_NODES_ALLOWED @KFCORE_ONNXRUNTIME_ALLOW_CPU_NODES@)
set(KFCore_LEGACY_MODEL_BACKENDS_ENABLED @KFCORE_ENABLE_LEGACY_MODEL_BACKENDS@)

list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")

find_dependency(Salts CONFIG REQUIRED
  PATHS "$ENV{SALTS_ROOT}"
  NO_DEFAULT_PATH)
find_dependency(SaltsUtils CONFIG REQUIRED
  PATHS "$ENV{SALTS_UTILS_ROOT}"
  NO_DEFAULT_PATH)

# Runtime execution plugins are installed deployment assets and are deliberately
# not part of the exported CMake link interface. Only the opt-in legacy model
# wrappers expose their vendor SDK dependencies to CMake consumers.
if(KFCore_LEGACY_MODEL_BACKENDS_ENABLED)
  if(KFCore_CUDA_ENABLED OR KFCore_ONNXRUNTIME_CUDA_ENABLED)
    find_dependency(CUDAToolkit)
  endif()
  if(KFCore_TENSORRT_ENABLED)
    find_package(TensorRT REQUIRED MODULE)
  endif()
  if(KFCore_ONNXRUNTIME_ENABLED)
    find_dependency(ONNXRuntime REQUIRED MODULE)
  endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/KFCoreTargets.cmake")

find_dependency(trackers CONFIG
  PATHS "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/cmake/trackers"
  NO_DEFAULT_PATH)

check_required_components(KFCore)
